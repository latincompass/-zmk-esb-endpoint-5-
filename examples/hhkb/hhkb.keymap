/*
 * SPDX-License-Identifier: MIT
 *
 * HHKB Professional 2 / Professional BT 标准配列
 *
 * 物理布局（5行 x 15列，不含空格行）：
 *
 *  Row 0: Esc  1    2    3    4    5    6    7    8    9    0    -    =    \    `~   Del
 *         (Power)(F1) (F2) (F3) (F4) (F5) (F6) (F7) (F8) (F9) (F10)(F11)(F12)(Ins)
 *
 *  Row 1: Tab  Q    W    E    R    T    Y    U    I    O    P    [    ]    \    Del
 *         (Caps)                                      (PSc) (Scr) (Pau) (BS/Clear)
 *
 *  Row 2: Ctl  A    S    D    F    G    H    J    K    L    ;    '    Return
 *         (VolOn)(VolUp)(Mute)(Eject)                (*) (/)  (Home)(PgUp)
 *
 *  Row 3: Sft  Z    X    C    V    B    N    M    ,    .    /    Sft  Fn
 *                                             (<) (>) (?)      (End)(PgDn)(Stop)
 *
 *  Row 4: Alt  Cmd        Space         Cmd  Alt
 *         (Opt) (◆)      (6.25u)       (◆)  (Opt/Stop)
 *
 * 标注说明：
 *   - HHKB 左上角 Esc 同时是 Power 键
 *   - Tab 键帽上印了 Caps 字样（表示 HHKB 的经典 Control 位置）
 *   - 底部左右 Alt 标注为 "Opt"
 *   - 底部左右 Cmd 用菱形符号表示
 *
 * ZMK matrix: 5 rows x 15 columns (60 keys excluding Fn layer)
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        /* ==================== Layer 0: HHKB Default ====================
         * 标准 HHKB 配列
         * - Control 在 A 键左侧（传统 Caps Lock 位置）
         * - 退格键在右上角（Delete 位置）
         * - `~ 在退格键左侧
         * - \ 在 `~ 左侧
         * - 方向键通过 Fn 层访问
         */
        default_layer {
            bindings = <
    &kp ESC    &kp N1   &kp N2   &kp N3   &kp N4   &kp N5   &kp N6   &kp N7   &kp N8   &kp N9   &kp N0   &kp MINUS &kp EQUAL &kp BSLH &kp GRAVE &kp BSPC
    &kp TAB    &kp Q    &kp W    &kp E    &kp R    &kp T    &kp Y    &kp U    &kp I    &kp O    &kp P    &kp LBKT  &kp RBKT  &kp BSLH &kp DEL
    &kp LCTL   &kp A    &kp S    &kp D    &kp F    &kp G    &kp H    &kp J    &kp K    &kp L    &kp SEMI &kp SQT   &kp RET
    &kp LSFT   &kp Z    &kp X    &kp C    &kp V    &kp B    &kp N    &kp M    &kp COMMA &kp DOT &kp FSLH &kp RSFT  &mo 1
    &kp LALT   &kp LGUI          &kp SPACE                            &kp RGUI  &kp RALT
            >;
        };

        /* ==================== Layer 1: Fn / HHKB Functions ====================
         * HHKB 的 Fn 层功能：
         * - F1-F12：配合数字键使用
         * - 方向键：[/]/'/; 位置
         * - 多媒体：音量控制、静音等
         * - 电源：Esc 位置
         * - 截图/滚动锁定：P 键周围
         */
        fn_layer {
            bindings = <
    &kp PWR    &kp F1   &kp F2   &kp F3   &kp F4   &kp F5   &kp F6   &kp F7   &kp F8   &kp F9   &kp F10  &kp F11   &kp F12   &kp INS   &kp DEL  &kp DEL
    &kp CLCK   &none    &none    &none    &none    &none    &none    &none    &kp PSCRN &kp SLCK &kp PAUSE_BREAK &kp UP    &none     &none     &kp DEL
    &kp LCTL   &none    &none    &none    &none    &none    &none    &none    &kp HOME  &kp PG_UP &kp LEFT &kp RIGHT &kp RET
    &kp LSFT   &none    &none    &none    &none    &none    &none    &none    &kp END   &kp PG_DN &kp DOWN &kp RSFT  &trans
    &kp LALT   &kp LGUI          &kp SPACE                            &kp RGUI  &kp RALT
            >;
        };

        /* ==================== Layer 2: Additional Functions ====================
         * 扩展功能层（可选）：
         * - 蓝牙设备切换
         * - 重置/DFU
         * - 特殊功能
         */
        system_layer {
            bindings = <
    &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none &none &none &none &none &none &none &none &none &none
    &none      &none    &none    &none    &none    &none    &none    &none    &none    &none    &none    &none    &none    &none    &none
    &none      &none    &none    &none    &none    &none    &none    &none    &none    &none    &none    &none    &none
    &none      &none    &none    &none    &none    &none    &none    &none    &none    &none    &none    &none    &trans
    &none      &none             &none                                &none     &none
            >;
        };
    };
};
