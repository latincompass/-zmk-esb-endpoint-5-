/*
 * SPDX-License-Identifier: MIT
 *
 * nRF52833 HHKB keyboard - DTS overlay
 *
 * This overlay configures the ESB endpoint for a 6-row × 8-column
 * HHKB-style matrix on nRF52833.
 *
 * HHKB Professional layout:
 *   - 6 rows, 8 columns (60% form factor)
 *   - 6KRO or NKRO
 *   - Split backspace, split right shift
 *   - 6.25u spacebar
 *
 * Known pins (nRF52833):
 *   Row pins:  P0.02 - P0.07  (6 rows)
 *   Col pins:  P0.08 - P0.15  (8 columns, or P0.08-P0.15 + P1.xx if more)
 *
 * IMPORTANT: Adjust the GPIO pins to match YOUR specific PCB wiring!
 * This is a generic example - verify against your schematic.
 */

/ {
    /* ESB endpoint node */
    zmk_esb: zmk_esb_endpoint {
        compatible = "zmk,esb-endpoint";
        esb-channel = <78>;
        pairing-base-address = [17 f4 07 aa];
        pairing-prefix = <0x24>;
        data-base-address = [b9 8a 16 22];
        data-prefix = <0xc2>;
    };

    /* ESB input processor for mouse/pointer events */
    esb_ip: esb_input_processor {
        compatible = "zmk,esb-input-processor";
        #input-processor-cells = <0>;
        status = "okay";
    };

    /* Keyboard matrix - HHKB 6x8 */
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        row-gpios
            = <&gpio0 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;

        col-gpios
            = <&gpio0 8 GPIO_ACTIVE_HIGH>
            , <&gpio0 9 GPIO_ACTIVE_HIGH>
            , <&gpio0 10 GPIO_ACTIVE_HIGH>
            , <&gpio0 11 GPIO_ACTIVE_HIGH>
            , <&gpio0 12 GPIO_ACTIVE_HIGH>
            , <&gpio0 13 GPIO_ACTIVE_HIGH>
            , <&gpio0 14 GPIO_ACTIVE_HIGH>
            , <&gpio0 15 GPIO_ACTIVE_HIGH>
            ;
    };

    /* LEDs (optional - Caps Lock indicator on P1.00) */
    /* leds: leds {
     *     compatible = "gpio-leds";
     *     caps_lock_led: led_0 {
     *         gpios = <&gpio1 0 GPIO_ACTIVE_HIGH>;
     *     };
     * }; */
};

/* Route pointer events to ESB input processor */
&mkp_input_listener { input-processors = <&esb_ip>; };
&msc_input_listener { input-processors = <&esb_ip>; };

/* Enable the esb_unpair behavior */
#include <behaviors/esb_unpair.dtsi>
